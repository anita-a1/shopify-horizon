{%- liquid
  # Get the first available variant
  assign variant = product.selected_or_first_available_variant
  assign available = variant.available
  
  # Button text
  if available
    assign button_text = 'Add to Cart'
  else
    assign button_text = 'Sold Out'
  endif
-%}

<div class="quick-add-wrapper">
  <quick-add-component 
    class="quick-add" 
    data-product-id="{{ product.id }}"
    data-product-title="{{ product.title | escape }}"
  >
    {%- comment -%} Hidden inputs for variant data {%- endcomment -%}
    <input type="hidden" name="id" value="{{ variant.id }}" data-variant-id>
    <input type="hidden" name="quantity" value="1">
    
    {%- comment -%} Add to Cart Button {%- endcomment -%}
    <button 
      type="button" 
      class="quick-add__button {% unless available %}quick-add__button--sold-out{% endunless %}"
      {% unless available %}disabled{% endunless %}
      aria-label="{{ button_text }} - {{ product.title }}"
    >
      <span class="quick-add__button-text">
        {{ button_text }}
      </span>
    </button>
  </quick-add-component>
</div>

<style>
  .quick-add {
    display: inline-block;
  }

  .quick-add__button {
    background: #000000;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 12px 24px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 140px;
  }

  .quick-add__button:hover:not(:disabled) {
    background: #333333;
    transform: translateY(-1px);
  }

  .quick-add__button:disabled {
    background: #cccccc;
    cursor: not-allowed;
    transform: none;
  }

  .quick-add__button--sold-out {
    background: #999999;
  }

  .quick-add__loading {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .quick-add__loading::after {
    content: '';
    width: 16px;
    height: 16px;
    border: 2px solid transparent;
    border-top: 2px solid currentColor;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  @keyframes slideIn {
    from {
      transform: translateX(100%);
      opacity: 0;
    }
    to {
      transform: translateX(0);
      opacity: 1;
    }
  }
</style>